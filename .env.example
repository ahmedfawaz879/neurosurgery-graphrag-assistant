# Copy this file to .env for local development: `cp .env.example .env`.
# Never commit .env -- it is gitignored.

# --- LLM backend ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI=true
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# --- Corpus ----------------------------------------------------------------------
CORPUS_MODE=shipped
REAL_PDF_DIR=/kaggle/input/your-neurosurgery-ai-papers

# --- Vector store ------------------------------------------------------------------
# ":memory:" for local dev with no external service; point at a running Qdrant
# service (e.g. the docker-compose `qdrant` service, or Qdrant Cloud) in production.
QDRANT_URL=:memory:
VECTOR_DB=qdrant
PINECONE_API_KEY=
PINECONE_INDEX_NAME=neurosurgery-ai-papers

# --- Graph backend -------------------------------------------------------------------
# "networkx" (default, zero external services) or "neo4j".
GRAPH_BACKEND=networkx
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- API ---------------------------------------------------------------------------------
# Restrict to your deployed frontend's origin in production; "*" is for local/dev only.
ALLOWED_ORIGIN=*
